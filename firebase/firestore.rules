rules_version = '2';
// Silverstein listings. Paste into Firebase console → Firestore Database → Rules, then Publish.
// Anyone may read what's on the site; only the emails in ADMINS may add, edit or delete (checked by Google's servers).
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in ['roeeritter@gmail.com'];   // more admins: add them to this list
    }
    match /listings/{id} {
      allow read: if resource.data.hidden == false || isAdmin();
      allow write: if isAdmin();
    }
    match /photos/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
